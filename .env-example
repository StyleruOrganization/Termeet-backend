POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

CONTAINER_REGISTRY=

# Яндекс OAuth. Только бэкенд (.env на сервере), не в фронт и не в git.
# CLIENT_SECRET — никому кроме контейнера backend-dev / backend-prod.
# В кабинете oauth.yandex.ru добавьте права: login:info, login:email и
# «Яндекс Календарь» (calendar:all). Без calendar:all синк не заработает.
CLIENT_ID=
CLIENT_SECRET=
# Куда Яндекс вернёт пользователя после кнопки «Войти через Яндекс»:
# https://termeet-dev.ru/auth/yandex
# В кабинете Яндекса добавь ещё URI виджета: https://termeet-dev.ru/yandex-suggest.html
REDIRECT_URI=

HTTPS_TRUE=

# Яндекс SMTP: SSL на 465. Логин — полный адрес ящика (не короткое имя).
# Пароль — пароль приложения из Яндекс ID, не пароль от почты.
# Локально без реальной почты: USE_MAILDEV=true, EMAIL_HOST=maildev, EMAIL_PORT=1025
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
VERIFICATION_LINK=
USE_MAILDEV=false

RESET_PASSWORD_LINK=

RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

RABBIT_HOST=
RABBIT_PORT=
RABBIT_USER=
RABBIT_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ADDRESS=
MINIO_CONSOLE_ADDRESS=

S3_BUCKET_NAME=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

GRPC_HOST=
GRPC_PORT=

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Telegram Alerts (Alertmanager -> Telegram Topic)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERTS_CHAT_ID=
TELEGRAM_ALERTS_THREAD_ID=